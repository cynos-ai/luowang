# The local host port for the Compose deployment.
LUOWANG_PORT=3000

# Required on the first start of a new data volume. Use long random values.
LUOWANG_ADMIN_PASSWORD=
LUOWANG_MASTER_KEY=

# Optional origin when the console is behind a known HTTPS reverse proxy.
LUOWANG_ALLOWED_ORIGIN=

# Optional Compose build mirrors. Keep the defaults unless a mirror is needed.
NODE_IMAGE=node:24.14.1-bookworm-slim
NPM_REGISTRY=https://registry.npmjs.org

# Local provisioning notes. External credentials are imported into the
# authenticated Secret Store; they are not passed to Runner child processes.
GITHUB_REPOSITORY=https://github.com/cynos-ai/cynos-website
GITHUB_SCENARIO_BRANCH=scenario-testing
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_API_KEY=
GITHUB_TOKEN=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=
OSS_ACCESS_MODE=private
OSS_OBJECT_PREFIX=luowang/evidence
