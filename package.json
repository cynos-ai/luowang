{
  "name": "luowang",
  "version": "0.1.0",
  "private": true,
  "description": "LuoWang AI scenario testing harness",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "build": "npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/server/db/migrate-cli.ts",
    "dev": "concurrently -k \"npm run dev:server\" \"vite\"",
    "dev:server": "tsx watch src/server/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "test:e2e": "npm run build && tsx tests/e2e/smoke.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "argon2": "^0.44.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.4.0",
    "pino": "^9.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
